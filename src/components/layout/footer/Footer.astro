---
// Pintu masuk footer: variasi dipilih lewat `footer.variant` di src/content/site.yaml (= nama file tanpa .astro). Daftar variasi: ./variants.ts.
import { getSite } from "@/lib/content";
import { pickVariant } from "@/lib/variants";
import { footerVariants } from "./variants";

const site = await getSite();
const { variant, ...footer } = site.footer;
// Saat build, variasi yang belum disetujui diganti FooterBasic_001 (tanpa desain), lihat lib/variants.ts.
const Variant = pickVariant(footerVariants, variant, "footer", "FooterBasic_001");
---

<Variant siteName={site.name} {...footer} />
