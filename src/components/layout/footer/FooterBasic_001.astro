---
// FooterBasic_001: versi bare minimum (tanpa desain). Hanya memastikan semua isi footer dari site.yaml tampil dan berfungsi.
import type { FooterProps } from "./types";

type Props = FooterProps;

const { siteName, company, address, email, socialsTitle, socials } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="container-page section-y">
  <p>{siteName}</p>
  <address class="not-italic">
    <p>{company}</p>
    {address.map((line) => <p>{line}</p>)}
    {email && <p><a href={`mailto:${email}`}>{email}</a></p>}
  </address>
  {
    socials.length > 0 && (
      <>
        {socialsTitle && <p>{socialsTitle}</p>}
        <ul>
          {socials.map((social) => (
            <li>
              <a href={social.href}>{social.platform}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
  <p>© {year} {company}</p>
</footer>
