---
// NavbarBasic_001: versi bare minimum (tanpa desain). Nama situs, menu, dan tombol aksi sebagai link teks biasa.
// Dipakai build selama belum ada desain navbar yang disetujui (variasi desain lain di folder yang sama berstatus draft, lihat src/content/variants.yaml).
import type { NavbarProps } from "./types";

type Props = NavbarProps;

const { siteName, cta, links } = Astro.props;
---

<header class="container-page">
  <p><a href="/">{siteName}</a></p>
  <nav aria-label="Menu utama">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
            {link.children && link.children.length > 0 && (
              <ul class="pl-4">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
  <p><a href={cta.href}>{cta.label}</a></p>
</header>
