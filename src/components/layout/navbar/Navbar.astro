---
// Pintu masuk navbar. Variasi: `navbar.variant` di src/content/site.yaml, dicari di kit situs (site.yaml › kit);
// file-nya di kits/<kit>/navbar/. Navbar selalu ikut kit situs, juga di halaman yang memakai kit lain.
// Isi: nama situs + cta dari site.yaml, item menu dari src/content/menu/*.yaml.
import { getMainLinks, getSite } from "@/lib/content";
import KitVariant from "@/components/sections/KitVariant.astro";

interface Props {
  /** Paksa variasi tertentu, mis. "parametris/NavbarDropdown_001" (dipakai halaman /prototype/navbar). */
  variant?: string;
  /** Kit halaman (tema di sekitarnya). Kosong = halaman prototype. */
  pageKit?: string;
}

const site = await getSite();
const links = await getMainLinks();
---

<KitVariant
  section="navbar"
  variant={Astro.props.variant ?? site.navbar.variant}
  kit={site.kit}
  pageKit={Astro.props.pageKit}
  siteName={site.name}
  cta={site.cta}
  links={links}
/>
