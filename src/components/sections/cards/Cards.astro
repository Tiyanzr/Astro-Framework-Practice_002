---
// Pintu masuk section kartu (`type: cards`). Isi kartu:
// - `from: <induk>` → otomatis dari halaman anak (src/content/pages/<induk>/*.yaml: title + summary, urut order), atau
// - `items` → daftar manual di YAML.
// Variasi: kits/<kit>/cards/.
import { getChildPages } from "@/lib/content";
import KitVariant from "../KitVariant.astro";

const { variant, kit, pageKit, from, items = [], ...props } = Astro.props;
const cards = from ? await getChildPages(from) : items;
---

<KitVariant section="cards" wrap variant={variant} kit={kit} pageKit={pageKit} items={cards} {...props} />
