---
// Pintu masuk daftar artikel (`type: posts`). Artikel dari src/content/posts/ (tanpa draft saat build), terbaru di atas.
// `limit` = jumlah artikel (kosong = semua), `category` = saring per kategori.
// `items` = daftar manual (mis. artikel di situs lain); kalau diisi, koleksi posts tidak dipakai.
// Variasi: kits/<kit>/posts/.
import { getPosts } from "@/lib/content";
import KitVariant from "../KitVariant.astro";
import type { PostItem } from "./types";

const { variant, kit, pageKit, limit, category, items, ...props } = Astro.props;
let posts: PostItem[];
if (items) {
  posts = items;
} else {
  const all = (await getPosts()).filter((p) => !category || p.data.category === category);
  posts = (limit ? all.slice(0, limit) : all).map(({ id, data }) => ({
    title: data.title,
    description: data.description,
    href: `/posts/${id}/`,
    pubDate: data.pubDate,
    category: data.category,
    cover: data.cover,
    coverAlt: data.coverAlt,
  }));
}
---

<KitVariant section="posts" wrap variant={variant} kit={kit} pageKit={pageKit} posts={posts} {...props} />
