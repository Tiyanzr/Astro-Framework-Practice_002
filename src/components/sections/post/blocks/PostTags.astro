---
// Daftar tag artikel. Tidak tampil kalau artikel tidak punya tag.
import type { PostData, PostLabels } from "../types";

interface Props {
  data: PostData;
  labels: PostLabels;
  class?: string;
}

const { data, labels, class: className } = Astro.props;
---

{
  data.tags.length > 0 && (
    <footer class:list={["border-t border-border pt-8", className]}>
      <ul class="flex flex-wrap gap-2" aria-label={labels.tags}>
        {data.tags.map((tag) => (
          <li class="rounded-sm border border-border px-2.5 py-1 text-caption text-muted-foreground">{tag}</li>
        ))}
      </ul>
    </footer>
  )
}
