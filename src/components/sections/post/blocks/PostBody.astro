---
// Isi artikel dari Markdown. Semua gaya isi (judul, gambar, quote/callout, tabel) diatur sekali di ./prose.css,
// jadi berlaku sama di semua variasi dan semua kit.
import "./prose.css";

interface Props {
  Content: any;
  class?: string;
}

const { Content, class: className } = Astro.props;
---

<div class:list={["prose max-w-none", className]}>
  <Content />
</div>
