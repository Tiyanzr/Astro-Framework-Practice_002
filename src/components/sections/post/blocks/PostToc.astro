---
// Daftar isi dari judul ## (dan ### kalau `nested`). Tidak tampil kalau judul ## kurang dari `min`.
// Judul yang sedang dibaca ditandai otomatis (garis hijau) saat halaman di-scroll.
import type { MarkdownHeading } from "astro";
import type { PostLabels } from "../types";

interface Props {
  headings: MarkdownHeading[];
  labels: PostLabels;
  /** Ikut menampilkan judul ###. */
  nested?: boolean;
  min?: number;
  class?: string;
}

const { headings, labels, nested = false, min = 3, class: className } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || (nested && h.depth === 3));
const show = headings.filter((h) => h.depth === 2).length >= min;
---

{
  show && (
    <nav class:list={["post-toc", className]} aria-label={labels.toc}>
      <p class="font-mono text-eyebrow text-muted-foreground uppercase">{labels.toc}</p>
      <ol class="mt-4 border-l border-border text-small">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={[
                "-ml-px block border-l-2 border-transparent py-1.5 pr-2 text-muted-foreground transition-colors duration-300 hover:text-foreground aria-[current=true]:border-primary aria-[current=true]:text-foreground",
                h.depth === 3 ? "pl-7" : "pl-4",
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // Tandai judul yang sedang dibaca: judul terakhir yang sudah melewati 1/3 atas layar.
  for (const toc of document.querySelectorAll<HTMLElement>(".post-toc")) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a")];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    const update = () => {
      let active = -1;
      targets.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top < window.innerHeight / 3) active = i;
      });
      links.forEach((a, i) => a.setAttribute("aria-current", String(i === active)));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
