---
// Pintu masuk artikel: menyiapkan isi, daftar judul, artikel terkait, dan label, lalu memilih variasi.
// Variasi: `variant` di frontmatter artikel, kalau kosong site.yaml › post.variant; dicari di kit situs (site.yaml › kit).
// File-nya di kits/<kit>/post/. Blok penyusun bersama (isi, daftar isi, ...) di ./blocks/.
import { render, type CollectionEntry } from "astro:content";
import { getRelatedPosts, getSite } from "@/lib/content";
import KitVariant from "../KitVariant.astro";

interface Props {
  post: CollectionEntry<"posts">;
  /** Paksa variasi tertentu (dipakai halaman /prototype/post). */
  variant?: string;
  /** Kit halaman (tema di sekitarnya). Kosong = halaman prototype. */
  pageKit?: string;
}

const { post, variant, pageKit } = Astro.props;
const site = await getSite();
const { Content, headings } = await render(post);
const related = await getRelatedPosts(post);
---

<KitVariant
  section="post"
  variant={variant ?? post.data.variant ?? site.post.variant}
  kit={site.kit}
  pageKit={pageKit}
  data={post.data}
  Content={Content}
  headings={headings}
  related={related}
  labels={site.post.labels}
/>
