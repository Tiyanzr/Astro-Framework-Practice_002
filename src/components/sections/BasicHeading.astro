---
// Judul section untuk variasi Basic (teks polos): eyebrow, judul (h2), pengantar. Semua opsional.
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

{eyebrow && <p>{eyebrow}</p>}
{title && <h2>{title}</h2>}
{description && <p>{description}</p>}
