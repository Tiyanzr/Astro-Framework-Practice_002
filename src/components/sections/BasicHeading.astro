---
// Judul section untuk variasi Basic (teks polos): eyebrow, judul (h2) + lanjutan `accent`, pengantar. Semua opsional.
interface Props {
  eyebrow?: string;
  title?: string;
  accent?: string;
  description?: string;
}

const { eyebrow, title, accent, description } = Astro.props;
---

{eyebrow && <p>{eyebrow}</p>}
{(title || accent) && <h2>{[title, accent].filter(Boolean).join(" ")}</h2>}
{description && <p>{description}</p>}
