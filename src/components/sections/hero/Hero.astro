---
// Pintu masuk hero: memilih variasi lewat prop `variant` (= nama file tanpa .astro). Daftar variasi: ./variants.ts.
import { pickVariant } from "@/lib/variants";
import { heroVariants } from "./variants";
import type { HeroProps } from "./types";

interface Props extends HeroProps {
  variant?: string;
}

const { variant = "HeroBasic_001", ...props } = Astro.props;
const Variant = pickVariant(heroVariants, variant, "hero");
---

<Variant {...props} />
