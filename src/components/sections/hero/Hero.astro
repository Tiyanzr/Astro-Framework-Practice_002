---
// Pintu masuk hero. Variasi dipilih lewat `variant` dari kit (src/lib/kits.ts), file-nya di kits/<kit>/hero/.
// Item menu utama disiapkan di sini (`menuLinks`), dipakai variasi yang menampilkan menu kalau `links` kosong.
import { getMainLinks } from "@/lib/content";
import KitVariant from "../KitVariant.astro";

const { variant, kit, pageKit, ...props } = Astro.props;
const menuLinks = await getMainLinks();
---

<KitVariant section="hero" variant={variant} kit={kit} pageKit={pageKit} menuLinks={menuLinks} {...props} />
