---
// HeroBasic_001: versi bare minimum (tanpa desain). Hanya memastikan semua isi hero dari YAML tampil dan berfungsi.
// Dipakai build selama belum ada desain hero yang disetujui (variasi desain lain di folder yang sama berstatus draft, lihat src/content/variants.yaml).
// `links` hanya tampil kalau diisi di YAML (fallback ke menu utama adalah perilaku desain HeroImage_002).
import { Image } from "astro:assets";
import type { HeroProps } from "./types";

type Props = HeroProps;

const { eyebrow, aside, title, accent, description, actions = [], image, links } = Astro.props;
const items = links ?? [];
---

<section class="container-page section-y">
  {eyebrow && <p>{eyebrow}</p>}
  {aside && <p>{aside.href ? <a href={aside.href}>{aside.label}</a> : aside.label}</p>}
  <h1>{[title, accent].filter(Boolean).join(" ")}</h1>
  {description && <p>{description}</p>}
  {
    actions.length > 0 && (
      <ul>
        {actions.map((action) => (
          <li>
            <a href={action.href}>{action.label}</a>
          </li>
        ))}
      </ul>
    )
  }
  {
    items.length > 0 && (
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.description && <> — {item.description}</>}
          </li>
        ))}
      </ul>
    )
  }
  {image && <Image src={image.src} alt={image.alt} widths={[640, 1280]} sizes="100vw" />}
</section>
