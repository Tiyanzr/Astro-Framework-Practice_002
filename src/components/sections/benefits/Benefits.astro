---
// Pintu masuk manfaat / bidang penerapan (`type: benefits`): ikon + judul + penjelasan (+ rincian), diisi `items` di YAML halaman.
// Variasi yang sama isinya bisa tampil sebagai grid berikon, deretan tag, atau dua kolom berincian.
// Daftar variasi: ./variants.ts. Saat build, variasi draft diganti BenefitsBasic_001.
import WrappedVariant from "../WrappedVariant.astro";
import { benefitsVariants } from "./variants";

const { variant = "BenefitsBasic_001", ...props } = Astro.props;
---

<WrappedVariant section="benefits" variants={benefitsVariants} variant={variant} fallback="BenefitsBasic_001" {...props} />
