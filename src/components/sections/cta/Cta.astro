---
// Pintu masuk ajakan bertindak (`type: cta`), biasanya di akhir halaman. Variasi: kits/<kit>/cta/.
import KitVariant from "../KitVariant.astro";

const { variant, kit, pageKit, ...props } = Astro.props;
---

<KitVariant section="cta" wrap variant={variant} kit={kit} pageKit={pageKit} {...props} />
