---
// CtaBasic_001: versi bare minimum (tanpa desain). Judul + pengantar + tombol sebagai link teks.
import BasicHeading from "../BasicHeading.astro";
import type { CtaProps } from "./types";

type Props = CtaProps;

const { actions = [], ...heading } = Astro.props;
---

<BasicHeading {...heading} />
{
  actions.length > 0 && (
    <ul>
      {actions.map((action) => (
        <li>
          <a href={action.href}>{action.label}</a>
        </li>
      ))}
    </ul>
  )
}
