---
// Pintu masuk teks bebas (`type: text`). `body` dipecah jadi paragraf (dipisah satu baris kosong).
// Variasi: kits/<kit>/text/.
import KitVariant from "../KitVariant.astro";

const { variant, kit, pageKit, body, ...props } = Astro.props;
const paragraphs: string[] = body?.split(/\n\s*\n/).map((p: string) => p.trim()).filter(Boolean) ?? [];
---

<KitVariant section="text" wrap variant={variant} kit={kit} pageKit={pageKit} paragraphs={paragraphs} {...props} />
