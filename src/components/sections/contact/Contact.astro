---
// Pintu masuk kontak (`type: contact`). Data kontak dari site.yaml › contact; label formulir dari YAML halaman.
// Daftar variasi: ./variants.ts. Saat build, variasi draft diganti ContactBasic_001.
import { getSite } from "@/lib/content";
import WrappedVariant from "../WrappedVariant.astro";
import { contactVariants } from "./variants";

const { variant = "ContactBasic_001", ...props } = Astro.props;
const site = await getSite();
---

<WrappedVariant section="contact" variants={contactVariants} variant={variant} fallback="ContactBasic_001" contact={site.contact} {...props} />
