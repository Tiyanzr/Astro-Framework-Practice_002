---
// Menampilkan daftar `sections` dari YAML halaman, berurutan dari atas ke bawah.
// Setiap item memilih pintu masuk lewat `type`; pintu masuk memilih variasi dari kit (src/lib/kits.ts).
// `kit` = kit halaman (pages › kit, kalau kosong site.yaml › kit). Kosong (halaman prototype) = kit situs, dan setiap
// section dibungkus tema kit-nya sendiri.
// Menambah JENIS section baru = tambah skemanya di src/content.config.ts (pages › sections), types.ts + pintu masuknya
// di folder ini, daftarkan di `components` di bawah, lalu buat variasinya di kits/base/<jenis>/.
import type { PageSection, SectionType } from "@/lib/content";
import Benefits from "./benefits/Benefits.astro";
import Cards from "./cards/Cards.astro";
import Catalog from "./catalog/Catalog.astro";
import Contact from "./contact/Contact.astro";
import Cta from "./cta/Cta.astro";
import Features from "./features/Features.astro";
import Hero from "./hero/Hero.astro";
import Intro from "./intro/Intro.astro";
import Media from "./media/Media.astro";
import Posts from "./posts/Posts.astro";
import Text from "./text/Text.astro";

const components: Record<SectionType, any> = {
  hero: Hero,
  intro: Intro,
  cards: Cards,
  catalog: Catalog,
  posts: Posts,
  text: Text,
  cta: Cta,
  contact: Contact,
  media: Media,
  features: Features,
  benefits: Benefits,
};

interface Props {
  sections: PageSection[];
  /** Kit halaman. */
  kit?: string;
}

const { sections, kit } = Astro.props;
---

{
  sections.map(({ type, ...props }) => {
    const Component = components[type];
    return <Component {...props} kit={kit} pageKit={kit} />;
  })
}
