---
// IntroMedia_002: tanpa pembatas — warna dasar polos selebar layar (width bawaan "full"), tanpa panel dan tanpa sudut membulat.
// Judul besar membentang di atas; di bawahnya paragraf + highlight (kiri) dan media bersudut tegas (kanan).
// HP: semua bertumpuk, media di paling bawah. Mulai lg: baris bawah dua kolom, rata atas.
import { Image } from "astro:assets";
import MediaPlaceholder from "@/components/ui/MediaPlaceholder.astro";
import YouTube from "@/components/ui/YouTube.astro";
import type { IntroContent } from "@/components/sections/intro/types";

type Props = IntroContent;

const { eyebrow, title, description, highlight, media } = Astro.props;
const paragraphs = description?.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) ?? [];
---

<div>
  {eyebrow && <p class="font-mono text-eyebrow text-primary uppercase">{eyebrow}</p>}
  <!-- Judul disamakan dengan judul HeroImage_002: font display (Roboto Condensed), text-h1, tanpa letter-spacing negatif. Tetap h2 karena h1 hanya satu per halaman (hero). -->
  <h2 class:list={["max-w-4xl font-display text-h1 tracking-normal text-balance", eyebrow && "mt-4"]}>{title}</h2>

  <div class:list={["mt-10 grid gap-10 md:mt-14", media && "lg:grid-cols-2 lg:gap-16"]}>
    <div>
      {paragraphs.map((paragraph, i) => <p class:list={["max-w-prose text-body text-muted-foreground md:text-lead", i > 0 && "mt-5"]}>{paragraph}</p>)}
      {highlight && <p class="mt-8 max-w-prose text-h4 text-balance">{highlight}</p>}
    </div>

    {
      media && (
        <div>
          {media.type === "youtube" && <YouTube id={media.id} title={media.title} square />}
          {media.type === "image" && (
            <Image src={media.src} alt={media.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-video w-full object-cover" />
          )}
          {media.type === "placeholder" && <MediaPlaceholder label={media.label} square />}
        </div>
      )
    }
  </div>
</div>
