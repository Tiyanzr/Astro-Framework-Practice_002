---
// Pintu masuk intro: memilih variasi lewat prop `variant` (= nama file tanpa .astro), lalu membungkusnya dengan ui/Section.
// Variasi hanya mengatur susunan isi; latar, lebar, dan pulldown diatur di sini supaya sama untuk semua variasi.
// Kalau tone/width/pulldown tidak diisi, dipakai bawaan variasi dari introDefaults (./variants.ts).
import Section from "@/components/ui/Section.astro";
import { isBasic, resolveVariant } from "@/lib/variants";
import { introDefaults, introVariants } from "./variants";
import type { IntroProps } from "./types";

interface Props extends IntroProps {
  variant?: string;
}

const { variant = "IntroBasic_001", tone, width, pulldown, ...content } = Astro.props;
// Untuk variasi Basic, tone/width/pulldown dari YAML diabaikan:
// pengaturan itu bagian dari desain, bukan isi.
const { Variant, name } = resolveVariant(introVariants, variant, "intro");
const defaults = introDefaults[name] ?? {};
const settings = isBasic(name) ? defaults : { tone: tone ?? defaults.tone, width: width ?? defaults.width, pulldown: pulldown ?? defaults.pulldown };
---

<Section tone={settings.tone} width={settings.width} pulldown={settings.pulldown}>
  <Variant {...content} />
</Section>
