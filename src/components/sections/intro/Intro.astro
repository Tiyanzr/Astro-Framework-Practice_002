---
// Pintu masuk intro (`type: intro`), dibungkus ui/Section (tone/width/pulldown; bawaan per variasi di kits/<kit>/kit.ts).
// Variasi: kits/<kit>/intro/.
import KitVariant from "../KitVariant.astro";

const { variant, kit, pageKit, ...props } = Astro.props;
---

<KitVariant section="intro" wrap variant={variant} kit={kit} pageKit={pageKit} {...props} />
