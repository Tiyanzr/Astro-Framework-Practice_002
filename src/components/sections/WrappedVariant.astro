---
// Bagian bersama semua pintu masuk section yang dibungkus ui/Section (cards, catalog, posts, text, cta, contact):
// pilih variasi (dengan pengganti Basic saat build, lihat lib/variants.ts), lalu bungkus dengan ui/Section.
// Untuk variasi Basic, tone/width/pulldown diabaikan (pengaturan desain, bukan isi).
// Semua prop selain yang di bawah diteruskan apa adanya ke variasi.
import Section from "@/components/ui/Section.astro";
import type { SectionSettings } from "@/lib/section";
import { isBasic, resolveVariant } from "@/lib/variants";

interface Props extends SectionSettings {
  /** Nama section untuk pesan log/error, mis. "cards". */
  section: string;
  variants: Record<string, any>;
  variant: string;
  /** Variasi Basic pengganti saat build. */
  fallback: string;
  /** Pengaturan pembungkus bawaan per variasi (kalau YAML tidak mengisinya). */
  defaults?: Record<string, SectionSettings>;
  [prop: string]: any;
}

const { section, variants, variant, fallback, defaults = {}, tone, width, pulldown, ...content } = Astro.props;
const { Variant, name } = await resolveVariant(variants, variant, section, fallback);
const base = defaults[name] ?? {};
const settings = isBasic(name) ? {} : { tone: tone ?? base.tone, width: width ?? base.width, pulldown: pulldown ?? base.pulldown };
---

<Section {...settings}>
  <Variant {...content} />
</Section>
