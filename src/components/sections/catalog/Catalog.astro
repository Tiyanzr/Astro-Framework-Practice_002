---
// Pintu masuk showcase produk (`type: catalog`). Data dari src/content/products/*.yaml (1 file = 1 kategori).
// `categories` = id kategori yang ditampilkan (kosong = semua), `limit` = jumlah produk per kategori
// (kosong = semua, 0 = tanpa daftar produk, mis. ringkasan di beranda).
// Variasi: kits/<kit>/catalog/.
import { getProductCategories } from "@/lib/content";
import KitVariant from "../KitVariant.astro";

const { variant, kit, pageKit, categories: ids, limit, ...props } = Astro.props;
const categories = (await getProductCategories(ids)).map(({ id, data }) => ({
  id,
  title: data.title,
  summary: data.summary,
  image: data.image,
  items: limit === undefined ? data.items : data.items.slice(0, limit),
}));
---

<KitVariant section="catalog" wrap variant={variant} kit={kit} pageKit={pageKit} categories={categories} {...props} />
