---
// Pintu masuk section gambar (`type: media`): banner foto penuh atau gambar lebar sebagai section sendiri.
// Tidak dibungkus ui/Section, karena banner memenuhi lebar layar; setiap variasi mengatur lebarnya sendiri.
// Daftar variasi: ./variants.ts. Saat build, variasi draft diganti MediaBasic_001.
import { pickVariant } from "@/lib/variants";
import { mediaVariants } from "./variants";
import type { MediaProps } from "./types";

interface Props extends MediaProps {
  variant?: string;
}

const { variant = "MediaBasic_001", ...props } = Astro.props;
const Variant = await pickVariant(mediaVariants, variant, "media", "MediaBasic_001");
---

<Variant {...props} />
