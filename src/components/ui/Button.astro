---
// Tombol berbentuk link. primary = isi warna aksi utama, secondary = garis tepi.
// outline / solid = gaya parametris.com: garis warna teks, hover terisi (outline) atau terisi warna teks (solid).
// square = sudut tegas (gaya parametris.com). Warna mengikuti token, jadi otomatis benar di section terang maupun theme-dark.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary" | "outline" | "solid";
  size?: "md" | "lg";
  square?: boolean;
}

const { href, variant = "primary", size = "md", square = false, class: className, ...rest } = Astro.props;

const variants = {
  primary: "bg-primary text-primary-foreground hover:bg-primary-hover",
  secondary: "border border-foreground/25 text-foreground hover:border-foreground hover:bg-foreground/5",
  outline: "border border-foreground text-foreground hover:bg-foreground hover:text-background",
  solid: "border border-foreground bg-foreground text-background hover:bg-transparent hover:text-foreground",
};
const sizes = {
  md: "h-10 px-4 text-small",
  lg: "h-12 px-6 text-body",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 font-semibold whitespace-nowrap transition-colors duration-300 ease-out-quart",
    square ? "rounded-none" : "rounded-md",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
