---
// Label nama variasi di halaman /prototype/*, ditaruh di atas setiap variasi yang dibandingkan.
// Status otomatis dari src/content/variants.yaml: draft (kuning), pass = disetujui (hijau), base = Basic (garis).
import { variantStatus } from "@/lib/variants";
import { statusLabel } from "./controls";

interface Props {
  section: string;
  name: string;
  /** Keterangan tambahan, mis. "tone dark · width full". */
  note?: string;
}

const { section, name, note } = Astro.props;
const status = await variantStatus(section, name);
const badge = {
  draft: "bg-lime text-black",
  approved: "bg-primary text-primary-foreground",
  basic: "border border-border",
}[status];
---

<p class="flex flex-wrap items-center gap-3 border-y border-border bg-background-alt px-4 py-2 font-mono text-eyebrow uppercase md:px-8">
  {name}
  <span class:list={["rounded-sm px-1.5 py-0.5", badge]}>{statusLabel[status]}</span>
  {note && <span class="text-muted-foreground">{note}</span>}
</p>
