---
// Label nama variasi di halaman /prototype/*, ditaruh di atas setiap variasi yang dibandingkan.
// Variasi kandidat (src/prototype/variants/) otomatis diberi tanda KANDIDAT.
import { candidateNames } from "@/lib/variants";

interface Props {
  name: string;
}

const { name } = Astro.props;
const candidate = candidateNames.has(name.split(" ")[0]);
---

<p class="flex items-center gap-3 border-y border-border bg-background-alt px-4 py-2 font-mono text-eyebrow uppercase md:px-8">
  {name}
  {candidate && <span class="rounded-sm bg-lime px-1.5 py-0.5 text-black">Kandidat</span>}
</p>
