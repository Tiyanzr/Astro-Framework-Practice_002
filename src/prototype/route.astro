---
// Rute penampung /prototype/[...path] (hanya saat dev, didaftarkan oleh ./integration.mjs, dirender per permintaan
// supaya ?query terbaca). Setiap file di src/prototype/pages/ menjadi satu halaman:
// pages/hero.astro → /prototype/hero, pages/<folder>/x.astro → /prototype/<folder>/x. File baru langsung terbaca, tidak perlu restart.
// Sub-path tanpa file sendiri jatuh ke file segmen pertamanya dengan prop `path`:
// /prototype/referensi/iot/manufaktur → pages/referensi.astro, path = "iot/manufaktur".
const pages = import.meta.glob<{ default: any }>("./pages/**/*.astro");

const path = (Astro.params.path ?? "").replace(/\/$/, "");
const exact = [`./pages/${path}.astro`, `./pages/${path ? `${path}/` : ""}index.astro`].find((f) => f in pages);
const [first, ...rest] = path.split("/");
const parent = !exact && rest.length > 0 && `./pages/${first}.astro` in pages ? `./pages/${first}.astro` : undefined;
const file = exact ?? parent;
if (!file) return new Response(`Halaman prototype "/prototype/${path}" tidak ada di src/prototype/pages/.`, { status: 404 });

const { default: Page } = await pages[file]();
---

<Page path={parent ? rest.join("/") : undefined} />
