---
// Halaman pratinjau satu jenis section (dipakai src/prototype/pages/<section>.astro, cukup satu baris).
// Bar atas: variasi (?v=, "kit/Nama" dari semua kit) dan contoh isi (?c=). "Semua variasi" = semua variasi di semua kit
// berjajar dengan isi yang sama. Setiap variasi tampil dengan tema kit-nya sendiri (data-kit).
// Contoh isi = setiap section berjenis itu di semua halaman YAML (situs + halaman uji prototype).
// Bawaan: contoh pertama (beranda dulu), variasi = yang dipakai contoh itu.
// Variasi baru di kits/<kit>/<section>/ otomatis ikut (diberi tanda pemakaian dari src/prototype/usage.ts).
import { getCollection } from "astro:content";
import PrototypeLayout from "./PrototypeLayout.astro";
import VariantLabel from "./VariantLabel.astro";
import Sections from "@/components/sections/Sections.astro";
import { pageHref, type PageSection, type SectionType } from "@/lib/content";
import { allOption, control, fullRef, selected, siteKit, variantOptions } from "./controls";

interface Props {
  section: SectionType;
}

const { section } = Astro.props;
const kit = await siteKit();

// Semua contoh isi: beranda dulu, lalu halaman lain urut abjad.
const pages = (await getCollection("pages")).sort((a, b) => Number(a.id !== "home") - Number(b.id !== "home") || a.id.localeCompare(b.id));
const samples = pages.flatMap((page) =>
  page.data.sections
    .map((s, i) => ({ s, i }))
    .filter(({ s }) => s.type === section)
    .map(({ s, i }) => ({
      value: `${page.id}:${i}`,
      label: `Isi ${pageHref(page.id)} #${i + 1}`,
      section: s as PageSection,
      kit: page.data.kit ?? kit,
    })),
);

const sample = control(Astro.url, "c", "Contoh isi", samples);
const chosen = samples.find((s) => s.value === sample.value);
const variant = control(
  Astro.url,
  "v",
  "Variasi",
  [...(await variantOptions(section)), allOption],
  chosen && fullRef(section, chosen.section.variant, chosen.kit),
);
const shown = selected(variant);
---

<PrototypeLayout title={section} controls={[variant, sample]}>
  {
    !chosen ? (
      <p class="container-page section-y text-muted-foreground">Belum ada halaman YAML yang memakai section `{section}`.</p>
    ) : (
      shown.map((ref) => (
        <div>
          {shown.length > 1 && <VariantLabel name={ref} />}
          <Sections sections={[{ ...chosen.section, variant: ref } as PageSection]} />
        </div>
      ))
    )
  }
</PrototypeLayout>
