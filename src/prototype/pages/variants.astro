---
// /prototype/variants: daftar SEMUA variasi di semua section, dibuat otomatis dari file di src/components/.
// - "Pemakaian" & "Dipakai di" dihitung dari YAML (src/prototype/usage.ts): halaman, site.yaml (navbar, footer, post),
//   dan frontmatter artikel. Pemakaian di halaman/artikel uji (src/prototype/content/) ditandai "uji" dan tidak dihitung.
// - "Preview" membuka /prototype/<section>?v=<variasi> kalau halaman preview section itu ada.
// Variasi baru (file <Nama><Gaya>_<NNN>.astro di folder section) langsung muncul di sini sebagai "tidak dipakai".
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import { getUsage, placesOf, useBadge, useOf, type Place, type VariantUse } from "@/prototype/usage";

// Semua file variasi: src/components/<sections|layout>/<section>/<Nama>_<NNN>.astro (hanya nama file, tidak dimuat).
const files = Object.keys(import.meta.glob("/src/components/{sections,layout}/*/*_[0-9][0-9][0-9].astro"));
const previewPages = new Set(
  Object.keys(import.meta.glob("./*.astro")).map((f) => f.replace(/^\.\//, "").replace(/\.astro$/, "")),
);
const usage = await getUsage();

type Row = { section: string; name: string; use: VariantUse; usedIn: Place[]; preview?: string };
const rows: Row[] = files.map((file) => {
  const [section, base] = file.split("/").slice(-2);
  const name = base.replace(/\.astro$/, "");
  return {
    section,
    name,
    use: useOf(usage, section, name),
    usedIn: placesOf(usage, section, name),
    preview: previewPages.has(section) ? `/prototype/${section}?v=${name}` : undefined,
  };
});
// Urut: per section (urutan seperti di halaman: navbar dulu, footer terakhir), lalu dipakai → base → tidak dipakai, lalu nama.
const sectionOrder = ["navbar", "hero", "intro", "media", "cards", "catalog", "features", "benefits", "posts", "text", "cta", "contact", "footer", "post"];
const useOrder: Record<VariantUse, number> = { dipakai: 0, base: 1, "tidak dipakai": 2 };
const rank = (s: string) => (sectionOrder.includes(s) ? sectionOrder.indexOf(s) : sectionOrder.length);
rows.sort((a, b) => rank(a.section) - rank(b.section) || a.section.localeCompare(b.section) || useOrder[a.use] - useOrder[b.use] || a.name.localeCompare(b.name));

const count = (use: VariantUse) => rows.filter((r) => r.use === use).length;
---

<PrototypeLayout title="Variasi">
  <section class="container-page section-y">
    <h1 class="text-h2">Semua variasi</h1>
    <p class="mt-3 max-w-prose text-small text-muted-foreground">
      {rows.length} variasi: {count("dipakai")} dipakai di situs, {count("tidak dipakai")} tidak dipakai, {count("base")} base (versi Basic yang tidak
      dipakai). Yang tampil di situs = variasi yang ditulis di YAML, sama saat dev dan build. Variasi tidak dipakai boleh dihapus kalau tidak
      diperlukan lagi (riwayatnya tetap ada di git); versi Basic jangan dihapus.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-small">
        <thead class="border-b border-border font-mono text-eyebrow text-muted-foreground uppercase">
          <tr>
            <th class="py-2 pr-4 font-normal">Section</th>
            <th class="py-2 pr-4 font-normal">Variasi</th>
            <th class="py-2 pr-4 font-normal">Pemakaian</th>
            <th class="py-2 pr-4 font-normal">Dipakai di</th>
            <th class="py-2 font-normal">Preview</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, i) => (
              <tr class:list={["border-b border-border align-top", i > 0 && rows[i - 1].section !== row.section && "border-t-2 border-t-foreground/20"]}>
                <td class="py-2 pr-4 font-mono">{i === 0 || rows[i - 1].section !== row.section ? row.section : ""}</td>
                <td class="py-2 pr-4 font-mono">{row.name}</td>
                <td class="py-2 pr-4">
                  <span class:list={["rounded-sm px-1.5 py-0.5 font-mono text-eyebrow whitespace-nowrap uppercase", useBadge[row.use]]}>{row.use}</span>
                </td>
                <td class="py-2 pr-4">
                  {row.usedIn.length === 0 ? (
                    <span class="text-muted-foreground">—</span>
                  ) : (
                    row.usedIn.map((u, j) => (
                      <>
                        {j > 0 && ", "}
                        {u.href ? <a href={u.href} class="underline underline-offset-2 hover:text-primary">{u.label}</a> : u.label}
                        {u.test && <span class="text-muted-foreground"> (uji)</span>}
                      </>
                    ))
                  )}
                </td>
                <td class="py-2">
                  {row.preview ? <a href={row.preview} class="underline underline-offset-2 hover:text-primary">Buka</a> : <span class="text-muted-foreground">—</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</PrototypeLayout>
