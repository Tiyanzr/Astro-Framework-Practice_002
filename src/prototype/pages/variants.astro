---
// /prototype/variants: daftar SEMUA variasi di semua section, dibuat otomatis dari file di src/components/.
// - Status dari src/content/variants.yaml (draft / disetujui / basic).
// - "Dipakai di" dari YAML: halaman (src/content/pages/ › sections), site.yaml (navbar, footer, post), dan frontmatter artikel.
// - "Preview" membuka /prototype/<section>?v=<variasi> kalau halaman preview section itu ada.
// Variasi baru (file <Nama><Gaya>_<NNN>.astro di folder section) langsung muncul di sini sebagai draft.
import { getCollection } from "astro:content";
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import { getSite, pageHref } from "@/lib/content";
import { variantStatus, type VariantStatus } from "@/lib/variants";
import { statusLabel } from "@/prototype/controls";

// Semua file variasi: src/components/<sections|layout>/<section>/<Nama>_<NNN>.astro (hanya nama file, tidak dimuat).
const files = Object.keys(import.meta.glob("/src/components/{sections,layout}/*/*_[0-9][0-9][0-9].astro"));
const previewPages = new Set(
  Object.keys(import.meta.glob("./*.astro")).map((f) => f.replace(/^\.\//, "").replace(/\.astro$/, "")),
);

// Pemakaian: "<section>:<variasi>" → daftar tempat.
const usage = new Map<string, { label: string; href?: string }[]>();
const use = (section: string, variant: string, label: string, href?: string) => {
  const key = `${section}:${variant}`;
  usage.set(key, [...(usage.get(key) ?? []), { label, href }]);
};
for (const page of await getCollection("pages")) {
  const href = pageHref(page.id);
  for (const s of page.data.sections) use(s.type, s.variant, href, href);
}
const site = await getSite();
use("navbar", site.navbar.variant, "semua halaman (site.yaml)");
use("footer", site.footer.variant, "semua halaman (site.yaml)");
use("post", site.post.variant, "semua artikel (site.yaml)");
for (const post of await getCollection("posts")) {
  if (post.data.variant) use("post", post.data.variant, `/posts/${post.id}/`, `/posts/${post.id}/`);
}

type Row = { section: string; name: string; status: VariantStatus; usedIn: { label: string; href?: string }[]; preview?: string };
const rows: Row[] = await Promise.all(
  files.map(async (file) => {
    const [section, base] = file.split("/").slice(-2);
    const name = base.replace(/\.astro$/, "");
    return {
      section,
      name,
      status: await variantStatus(section, name),
      usedIn: usage.get(`${section}:${name}`) ?? [],
      preview: previewPages.has(section) ? `/prototype/${section}?v=${name}` : undefined,
    };
  }),
);
// Urut: per section (urutan seperti di halaman: navbar dulu, footer terakhir), lalu Basic → disetujui → draft, lalu nama.
const sectionOrder = ["navbar", "hero", "intro", "cards", "catalog", "posts", "text", "cta", "contact", "footer", "post"];
const statusOrder: Record<VariantStatus, number> = { basic: 0, approved: 1, draft: 2 };
const rank = (s: string) => (sectionOrder.includes(s) ? sectionOrder.indexOf(s) : sectionOrder.length);
rows.sort((a, b) => rank(a.section) - rank(b.section) || a.section.localeCompare(b.section) || statusOrder[a.status] - statusOrder[b.status] || a.name.localeCompare(b.name));

const count = (status: VariantStatus) => rows.filter((r) => r.status === status).length;
const badge: Record<VariantStatus, string> = {
  draft: "bg-lime text-black",
  approved: "bg-primary text-primary-foreground",
  basic: "border border-border",
};
---

<PrototypeLayout title="Variasi">
  <section class="container-page section-y">
    <h1 class="text-h2">Semua variasi</h1>
    <p class="mt-3 max-w-prose text-small text-muted-foreground">
      {rows.length} variasi: {count("approved")} disetujui, {count("draft")} draft, {count("basic")} basic. Menyetujui variasi = tambahkan namanya
      di <code>src/content/variants.yaml</code>. Saat build, variasi draft otomatis diganti versi Basic.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-small">
        <thead class="border-b border-border font-mono text-eyebrow text-muted-foreground uppercase">
          <tr>
            <th class="py-2 pr-4 font-normal">Section</th>
            <th class="py-2 pr-4 font-normal">Variasi</th>
            <th class="py-2 pr-4 font-normal">Status</th>
            <th class="py-2 pr-4 font-normal">Dipakai di</th>
            <th class="py-2 font-normal">Preview</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, i) => (
              <tr class:list={["border-b border-border align-top", i > 0 && rows[i - 1].section !== row.section && "border-t-2 border-t-foreground/20"]}>
                <td class="py-2 pr-4 font-mono">{i === 0 || rows[i - 1].section !== row.section ? row.section : ""}</td>
                <td class="py-2 pr-4 font-mono">{row.name}</td>
                <td class="py-2 pr-4">
                  <span class:list={["rounded-sm px-1.5 py-0.5 font-mono text-eyebrow uppercase", badge[row.status]]}>{statusLabel[row.status]}</span>
                </td>
                <td class="py-2 pr-4">
                  {row.usedIn.length === 0 ? (
                    <span class="text-muted-foreground">—</span>
                  ) : (
                    row.usedIn.map((u, j) => (
                      <>
                        {j > 0 && ", "}
                        {u.href ? <a href={u.href} class="underline underline-offset-2 hover:text-primary">{u.label}</a> : u.label}
                      </>
                    ))
                  )}
                </td>
                <td class="py-2">
                  {row.preview ? <a href={row.preview} class="underline underline-offset-2 hover:text-primary">Buka</a> : <span class="text-muted-foreground">—</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</PrototypeLayout>
