---
// /prototype/variants: daftar SEMUA variasi di semua kit, discan otomatis dari kits/<kit>/<section>/*.astro
// (src/lib/kits.ts). Daftarnya sama persis dengan yang dikenali situs dan combo box /prototype/<section>:
// file baru (termasuk hasil duplikat/copy), section baru, atau kit baru langsung muncul di sini.
// - "Pemakaian" & "Dipakai di" dihitung dari YAML (src/prototype/usage.ts): halaman, site.yaml (navbar, footer, post),
//   dan frontmatter artikel. Pemakaian di halaman/artikel uji (src/prototype/content/) ditandai "uji" dan tidak dihitung.
// - "Preview" membuka /prototype/<section>?v=<kit/Nama> kalau halaman preview section itu ada.
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import { kits, refOf } from "@/lib/kits";
import { getUsage, placesOf, useBadge, useOf, type Place, type VariantUse } from "@/prototype/usage";

const previewPages = new Set(
  Object.keys(import.meta.glob("./*.astro")).map((f) => f.replace(/^\.\//, "").replace(/\.astro$/, "")),
);
const usage = await getUsage();

type Row = { section: string; kit: string; name: string; ref: string; use: VariantUse; usedIn: Place[]; preview?: string };
const rows: Row[] = kits.flatMap((kit) =>
  Object.entries(kit.sections).flatMap(([section, variants]) =>
    Object.keys(variants).map((name) => {
      const ref = refOf(kit.id, name);
      return {
        section,
        kit: kit.id,
        name,
        ref,
        use: useOf(usage, ref),
        usedIn: placesOf(usage, ref),
        preview: previewPages.has(section) ? `/prototype/${section}?v=${encodeURIComponent(ref)}` : undefined,
      };
    }),
  ),
);
// Urut: per section (urutan seperti di halaman: navbar dulu, footer terakhir), lalu dipakai → base → tidak dipakai,
// lalu kit, lalu nama. Section yang tidak ada di daftar ini (mis. section baru) tetap tampil, di urutan abjad setelahnya.
const sectionOrder = ["navbar", "hero", "intro", "media", "cards", "catalog", "features", "benefits", "posts", "text", "cta", "contact", "footer", "post"];
const useOrder: Record<VariantUse, number> = { dipakai: 0, base: 1, "tidak dipakai": 2 };
const rank = (s: string) => (sectionOrder.includes(s) ? sectionOrder.indexOf(s) : sectionOrder.length);
rows.sort(
  (a, b) =>
    rank(a.section) - rank(b.section) ||
    a.section.localeCompare(b.section) ||
    useOrder[a.use] - useOrder[b.use] ||
    a.kit.localeCompare(b.kit) ||
    a.name.localeCompare(b.name),
);

const count = (use: VariantUse) => rows.filter((r) => r.use === use).length;
const sectionCount = new Set(rows.map((r) => r.section)).size;
---

<PrototypeLayout title="Variasi">
  <section class="container-page section-y">
    <h1 class="text-h2">Semua variasi</h1>
    <p class="mt-3 max-w-prose text-small text-muted-foreground">
      {rows.length} variasi di {sectionCount} section dan {kits.length} kit: {count("dipakai")} dipakai di situs, {count("tidak dipakai")} tidak dipakai,
      {count("base")} base (versi Basic yang tidak dipakai). Yang tampil di situs = variasi yang ditulis di YAML, sama saat dev dan build.
      Variasi tidak dipakai boleh dihapus kalau tidak diperlukan lagi (riwayatnya tetap ada di git); kit base jangan dihapus.
    </p>
    <p class="mt-2 max-w-prose text-small text-muted-foreground">
      Daftar ini discan otomatis dari folder <code class="font-mono">kits/</code>. Variasi baru cukup dibuat sebagai file di
      <code class="font-mono">kits/&lt;kit&gt;/&lt;section&gt;/</code>, lalu muat ulang halaman ini. Ringkasan per kit:
      <a href="/prototype/kits" class="underline underline-offset-2 hover:text-primary">/prototype/kits</a>.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[720px] text-left text-small">
        <thead class="border-b border-border font-mono text-eyebrow text-muted-foreground uppercase">
          <tr>
            <th class="py-2 pr-4 font-normal">Section</th>
            <th class="py-2 pr-4 font-normal">Kit</th>
            <th class="py-2 pr-4 font-normal">Variasi</th>
            <th class="py-2 pr-4 font-normal">Pemakaian</th>
            <th class="py-2 pr-4 font-normal">Dipakai di</th>
            <th class="py-2 font-normal">Preview</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, i) => (
              <tr class:list={["border-b border-border align-top", i > 0 && rows[i - 1].section !== row.section && "border-t-2 border-t-foreground/20"]}>
                <td class="py-2 pr-4 font-mono">{i === 0 || rows[i - 1].section !== row.section ? row.section : ""}</td>
                <td class="py-2 pr-4 font-mono">{row.kit}</td>
                <td class="py-2 pr-4 font-mono">{row.name}</td>
                <td class="py-2 pr-4">
                  <span class:list={["rounded-sm px-1.5 py-0.5 font-mono text-eyebrow whitespace-nowrap uppercase", useBadge[row.use]]}>{row.use}</span>
                </td>
                <td class="py-2 pr-4">
                  {row.usedIn.length === 0 ? (
                    <span class="text-muted-foreground">—</span>
                  ) : (
                    row.usedIn.map((u, j) => (
                      <>
                        {j > 0 && ", "}
                        {u.href ? <a href={u.href} class="underline underline-offset-2 hover:text-primary">{u.label}</a> : u.label}
                        {u.test && <span class="text-muted-foreground"> (uji)</span>}
                      </>
                    ))
                  )}
                </td>
                <td class="py-2">
                  {row.preview ? <a href={row.preview} class="underline underline-offset-2 hover:text-primary">Buka</a> : <span class="text-muted-foreground">—</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</PrototypeLayout>
