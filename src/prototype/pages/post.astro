---
// /prototype/post: coba variasi artikel dari semua kit. Bar atas: variasi (?v=, "kit/Nama") dan artikel (?p=).
// Semua variasi di kits/<kit>/post/ otomatis ikut, dengan tema kit-nya, diberi tanda pemakaian (src/prototype/usage.ts).
// Artikel: semua postingan, termasuk draft dan contoh di src/prototype/content/posts/ (bawaan: contoh-semua-elemen).
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import Post from "@/components/sections/post/Post.astro";
import { getPosts, getSite } from "@/lib/content";
import { control, fullRef, variantOptions } from "@/prototype/controls";

const site = await getSite();
const posts = await getPosts({ withTestPosts: true });
const shorten = (s: string) => (s.length > 60 ? `${s.slice(0, 57)}…` : s);

const variant = control(Astro.url, "v", "Variasi", await variantOptions("post"), fullRef("post", site.post.variant, site.kit));
const article = control(
  Astro.url,
  "p",
  "Artikel",
  posts.map((x) => ({ value: x.id, label: `${shorten(x.data.title)}${x.data.draft ? " · draft" : ""}` })),
  "contoh-semua-elemen",
);
const post = posts.find((x) => x.id === article.value)!;
---

<PrototypeLayout title="Artikel" controls={[variant, article]}>
  <Post post={post} variant={variant.value} />
</PrototypeLayout>
