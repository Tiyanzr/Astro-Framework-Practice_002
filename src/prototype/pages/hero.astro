---
// /prototype/hero: coba variasi hero dengan isi yang sama (hero pertama di src/content/pages/home/index.yaml).
// Pilih variasi di bar atas (?v=); "Semua" = semua variasi berjajar. Bawaan = variasi yang dipakai beranda.
// Semua variasi di src/components/sections/hero/ otomatis ikut, diberi tanda pemakaian (src/prototype/usage.ts).
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import Hero from "@/components/sections/hero/Hero.astro";
import VariantLabel from "@/prototype/VariantLabel.astro";
import { heroVariants } from "@/components/sections/hero/variants";
import { getSection } from "@/lib/content";
import { allOption, control, paletteClass, paletteControl, selected, sitePalette, variantOptions } from "@/prototype/controls";

const { type: _type, ...hero } = await getSection("home", "hero");
const variant = control(Astro.url, "v", "Variasi", [...(await variantOptions(Object.keys(heroVariants), "hero")), allOption], hero.variant);
const palette = paletteControl(Astro.url, await sitePalette());
const shown = selected(variant);
---

<PrototypeLayout title="Hero" controls={[variant, palette]}>
  <div class:list={[paletteClass(palette)]}>
  {
    shown.map((name) => (
      <div>
        {shown.length > 1 && <VariantLabel section="hero" name={name} />}
        <Hero {...hero} variant={name} />
      </div>
    ))
  }
  </div>
</PrototypeLayout>
