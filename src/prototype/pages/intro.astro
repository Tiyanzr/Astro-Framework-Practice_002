---
// /prototype/intro: coba variasi intro dari semua kit dengan isi yang sama (intro pertama di halaman contoh
// src/prototype/content/pages/contoh-halaman.yaml, karena situs sekarang tidak memakai intro).
// Bar atas: variasi (?v=, "kit/Nama") dan tone (?tone=). "Semua" = semua pilihan berjajar. Width mengikuti bawaan variasi
// (kits/<kit>/kit.ts), pulldown dimatikan. Bawaan = variasi + tone yang dipakai halaman contoh.
import { getEntry } from "astro:content";
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import Intro from "@/components/sections/intro/Intro.astro";
import VariantLabel from "@/prototype/VariantLabel.astro";
import { getSection } from "@/lib/content";
import { resolveVariant } from "@/lib/kits";
import { sectionTones } from "@/lib/section";
import { allOption, control, fullRef, selected, siteKit, variantOptions } from "@/prototype/controls";

const { type: _type, variant: sampleVariant, tone: sampleTone, width: _width, pulldown: _pulldown, ...content } = await getSection("contoh-halaman", "intro");
const sampleKit = (await getEntry("pages", "contoh-halaman"))?.data.kit ?? (await siteKit());
const defaultsOf = (ref: string) => resolveVariant("intro", ref, sampleKit).defaults;

const variant = control(Astro.url, "v", "Variasi", [...(await variantOptions("intro")), allOption], fullRef("intro", sampleVariant, sampleKit));
const tone = control(
  Astro.url,
  "tone",
  "Tone",
  [...sectionTones.map((t) => ({ value: t, label: `Tone ${t}` })), allOption],
  sampleTone ?? defaultsOf(variant.value === "semua" ? (fullRef("intro", sampleVariant, sampleKit) ?? "") : variant.value)?.tone ?? "default",
);
const combos = selected(variant).flatMap((ref) => selected(tone).map((t) => ({ ref, tone: t })));
---

<PrototypeLayout title="Intro" controls={[variant, tone]}>
  {
    combos.map(({ ref, tone }) => (
      <div>
        {combos.length > 1 && <VariantLabel name={ref} note={`tone ${tone} · width ${defaultsOf(ref).width ?? "full"}`} />}
        <Intro {...content} variant={ref} tone={tone as (typeof sectionTones)[number]} pulldown={false} />
      </div>
    ))
  }
</PrototypeLayout>
