---
// /prototype/coba/contoh: halaman coba-coba. Salin file ini untuk mencoba susunan halaman atau section baru.
// Semua file di src/prototype/pages/ otomatis menjadi halaman /prototype/... dan muncul di daftar /prototype.
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import Hero from "@/components/sections/hero/Hero.astro";
import ContohSection from "@/prototype/sections/ContohSection.astro";
import { getPage } from "@/lib/content";

const { hero } = await getPage("home");
---

<PrototypeLayout title="Contoh">
  <Hero {...hero} />
  <ContohSection title="Section coba-coba" />
</PrototypeLayout>
