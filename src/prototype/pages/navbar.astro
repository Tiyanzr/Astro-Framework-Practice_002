---
// /prototype/navbar: coba variasi navbar dari semua kit dengan isi yang sama (site.yaml + src/content/menu/).
// Pilih variasi di bar atas (?v=, "kit/Nama"); "Semua" = semua variasi berjajar. Bawaan = variasi yang dipakai situs.
// Semua variasi di kits/<kit>/navbar/ otomatis ikut, masing-masing dengan tema kit-nya, diberi tanda pemakaian.
// Setiap navbar ditaruh dalam bingkai ber-transform: elemen `fixed` di dalamnya menempel ke bingkai, bukan ke layar,
// jadi tidak menimpa bar pilihan. Tinggi bingkai memberi ruang untuk panel menu saat dibuka.
// Catatan: di mode "Semua", tombol menu hanya berfungsi di navbar pertama (id elemen sama).
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import Navbar from "@/components/layout/navbar/Navbar.astro";
import VariantLabel from "@/prototype/VariantLabel.astro";
import { getSite } from "@/lib/content";
import { allOption, control, fullRef, selected, variantOptions } from "@/prototype/controls";

const site = await getSite();
const variant = control(Astro.url, "v", "Variasi", [...(await variantOptions("navbar")), allOption], fullRef("navbar", site.navbar.variant, site.kit));
const shown = selected(variant);
---

<PrototypeLayout title="Navbar" controls={[variant]}>
  {
    shown.map((ref) => (
      <div>
        {shown.length > 1 && <VariantLabel name={ref} />}
        <div class="relative min-h-[560px] overflow-hidden border-b border-border [transform:translateZ(0)]">
          <Navbar variant={ref} />
        </div>
      </div>
    ))
  }
</PrototypeLayout>
