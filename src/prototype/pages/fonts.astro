---
// /prototype/fonts: perbandingan kandidat font judul. Teks biasa tetap Archivo.
// Setiap blok memakai kandidat untuk semua judul. Di situs: h1 = --display-family, h2–h6 = --heading-family (global.css).
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import { allOption, control, selected } from "@/prototype/controls";

const fonts = [
  { name: "Roboto Condensed", family: "Roboto Condensed Variable", note: "100–900 · dipakai untuk h1" },
  { name: "Schibsted Grotesk", family: "Schibsted Grotesk Variable", note: "400–900" },
  { name: "Hanken Grotesk", family: "Hanken Grotesk Variable", note: "100–900" },
  { name: "Instrument Sans", family: "Instrument Sans Variable", note: "400–700 (judul 800 tampil sebagai 700)" },
  { name: "Archivo", family: "Archivo Variable", note: "100–900 · font judul sebelumnya" },
];

// Bar atas: pilih font (?font=). Bawaan "Semua" = semua kandidat berjajar.
const font = control(Astro.url, "font", "Font", [allOption, ...fonts.map((f) => f.name)]);
const shown = fonts.filter((f) => selected(font).includes(f.name));
---

<PrototypeLayout title="Font" controls={[font]}>
  {
    shown.map((font) => (
      <section class="border-b border-border py-16">
        <div class="container-page" style={`--display-family: "${font.family}"; --heading-family: "${font.family}"`}>
          <p class="font-mono text-eyebrow text-muted-foreground uppercase">
            {font.name} · {font.note}
          </p>
          <h1 class="mt-6 text-display-xl">Teknologi bertemu kebutuhan nyata.</h1>
          <div class="mt-10 grid gap-10 md:grid-cols-2">
            <div>
              <h2 class="text-h2">7 Titik Kritis Kelistrikan pada Rumah Baru</h2>
              <p class="mt-4 max-w-prose text-muted-foreground">
                Mengacu pada standar PUIL 2020 dan SNI, berikut panduan lengkap mengenai hal-hal kelistrikan yang wajib Anda periksa sebelum
                serah terima rumah baru.
              </p>
            </div>
            <div class="space-y-3">
              <h3 class="text-h3">Kotak Panel MCB &amp; Pembagian Grup</h3>
              <h4 class="text-h4 text-primary">Button 1</h4>
              <p class="text-small text-muted-foreground">ABCDEFGHIJKLM abcdefghijklm 0123456789 &amp; ? !</p>
            </div>
          </div>
        </div>
      </section>
    ))
  }
</PrototypeLayout>
