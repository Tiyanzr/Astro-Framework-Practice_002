---
// /prototype/footer: coba variasi footer dari semua kit dengan isi yang sama (src/content/site.yaml › footer).
// Pilih variasi di bar atas (?v=, "kit/Nama"); "Semua" = semua variasi berjajar. Bawaan = variasi yang dipakai situs.
// Semua variasi di kits/<kit>/footer/ otomatis ikut, masing-masing dengan tema kit-nya, diberi tanda pemakaian.
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";
import Footer from "@/components/layout/footer/Footer.astro";
import VariantLabel from "@/prototype/VariantLabel.astro";
import { getSite } from "@/lib/content";
import { allOption, control, fullRef, selected, variantOptions } from "@/prototype/controls";

const site = await getSite();
const variant = control(Astro.url, "v", "Variasi", [...(await variantOptions("footer")), allOption], fullRef("footer", site.footer.variant, site.kit));
const shown = selected(variant);
---

<PrototypeLayout title="Footer" controls={[variant]}>
  {
    shown.map((ref) => (
      <div>
        {shown.length > 1 && <VariantLabel name={ref} />}
        <Footer variant={ref} />
      </div>
    ))
  }
</PrototypeLayout>
