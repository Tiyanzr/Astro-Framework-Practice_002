---
// /prototype: daftar semua halaman prototype, dibuat otomatis dari file di src/prototype/pages/. Hanya ada saat `astro dev`.
// Halaman baru cukup ditambah sebagai file; judul diambil dari nama file.
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";

// Keterangan untuk halaman perbandingan tetap. Halaman lain (coba/, tutorial/, ...) tampil dengan nama filenya saja.
const notes: Record<string, string> = {
  colors: "Palet, turunan, dan versi section gelap",
  fonts: "Kandidat font judul",
  hero: "Semua variasi hero (produksi + kandidat)",
  intro: "Semua variasi intro di semua tone",
  footer: "Semua variasi footer",
  post: "Semua variasi artikel, pilih artikel contoh",
};

const groups = new Map<string, { href: string; title: string; description?: string }[]>();
for (const file of Object.keys(import.meta.glob("./**/*.astro"))) {
  const path = file.replace(/^\.\//, "").replace(/\.astro$/, "");
  if (path === "index") continue;
  const parts = path.split("/");
  const group = parts.length > 1 ? parts[0] : "perbandingan";
  const list = groups.get(group) ?? [];
  list.push({ href: `/prototype/${path.replace(/(^|\/)index$/, "")}`, title: parts.at(-1)!, description: notes[path] });
  groups.set(group, list);
}
---

<PrototypeLayout title="Daftar">
  <section class="section-y mx-auto max-w-3xl px-(--page-gutter)">
    <p class="font-mono text-eyebrow text-primary uppercase">Hanya saat astro dev · tidak ikut build</p>
    <h1 class="mt-4 text-h1">Prototype</h1>
    {
      [...groups].map(([group, items]) => (
        <div class="mt-12">
          <h2 class="font-mono text-eyebrow text-muted-foreground uppercase">{group}</h2>
          <ul class="mt-3 divide-y divide-border border-y border-border">
            {items.map((item) => (
              <li>
                <a href={item.href} class="flex items-center gap-4 px-2 py-5 transition-colors duration-300 ease-out-quart hover:bg-background-alt md:px-3">
                  <span class="flex-1">
                    <span class="block text-h4 text-primary">{item.title}</span>
                    {item.description && <span class="mt-0.5 block text-small text-muted-foreground">{item.description}</span>}
                  </span>
                  <svg class="size-5 shrink-0 text-primary" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="m7.5 4 6 6-6 6" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</PrototypeLayout>
