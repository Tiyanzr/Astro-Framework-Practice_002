---
// /prototype: daftar semua halaman prototype, dibuat otomatis dari file di src/prototype/pages/. Hanya ada saat `astro dev`.
// Halaman baru cukup ditambah sebagai file; judul diambil dari nama file.
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";

// Keterangan untuk halaman perbandingan tetap. Halaman lain tampil dengan nama filenya saja.
const notes: Record<string, string> = {
  colors: "Palet warna, turunan, dan versi section gelap",
  fonts: "Kandidat font judul",
  post: "Tampilan halaman artikel, pilih artikel contoh",
  hero: "Semua variasi hero",
  intro: "Semua variasi intro di semua tone",
  footer: "Semua variasi footer",
  navbar: "Semua variasi navbar",
  cards: "Semua variasi kartu, isi dari halaman YAML",
  catalog: "Semua variasi showcase produk",
  posts: "Semua variasi daftar artikel",
  text: "Semua variasi teks",
  cta: "Semua variasi ajakan bertindak",
  contact: "Semua variasi kontak",
  media: "Section gambar: banner foto & gambar lebar (baru)",
  features: "Daftar kapabilitas bernomor (baru)",
  benefits: "Manfaat: grid ikon, tag, dua kolom (baru)",
  variants: "Daftar SEMUA variasi: status (base/pass/draft) dan halaman yang memakainya",
};

// Pengelompokan daftar (urutan grup & isi mengikuti daftar ini; template YAML tiap bagian ada di MODULES.md):
// - Mandatory: berlaku di SEMUA halaman, diatur sekali (site.yaml, menu, global.css)
// - Modul: section yang disusun per halaman di `sections:` YAML halaman
// - Tinjauan: alat melihat status & hasil keseluruhan
// File baru yang belum tercantum otomatis masuk grup "Lainnya".
const groupDefs = [
  { name: "Mandatory", note: "Berlaku di semua halaman, diatur sekali", pages: ["colors", "fonts", "navbar", "footer", "post"] },
  {
    name: "Modul",
    note: "Disusun per halaman di sections YAML · template di MODULES.md",
    pages: ["hero", "intro", "media", "cards", "catalog", "features", "benefits", "posts", "text", "cta", "contact"],
  },
  { name: "Tinjauan", note: "Status semua variasi", pages: ["variants"] },
];

const files = Object.keys(import.meta.glob("./**/*.astro"))
  .map((f) => f.replace(/^\.\//, "").replace(/\.astro$/, ""))
  .filter((p) => p !== "index");
const item = (path: string) => ({ href: `/prototype/${path.replace(/(^|\/)index$/, "")}`, title: path.split("/").at(-1)!, description: notes[path] });
const listed = new Set(groupDefs.flatMap((g) => g.pages));
const groups = [
  ...groupDefs.map((g) => ({ ...g, items: g.pages.filter((p) => files.includes(p)).map(item) })),
  { name: "Lainnya", note: undefined, items: files.filter((p) => !listed.has(p)).map(item) },
].filter((g) => g.items.length > 0);
---

<PrototypeLayout title="Daftar">
  <section class="section-y mx-auto max-w-3xl px-(--page-gutter)">
    <h1 class="text-h1">Prototype</h1>
    {
      groups.map((group) => (
        <div class="mt-12">
          <h2 class="font-mono text-eyebrow text-muted-foreground uppercase">{group.name}</h2>
          {group.note && <p class="mt-1 text-small text-muted-foreground">{group.note}</p>}
          <ul class="mt-3 divide-y divide-border border-y border-border">
            {group.items.map((item) => (
              <li>
                <a href={item.href} class="flex items-center gap-4 px-2 py-5 transition-colors duration-300 ease-out-quart hover:bg-background-alt md:px-3">
                  <span class="flex-1">
                    <span class="block text-h4 text-primary">{item.title}</span>
                    {item.description && <span class="mt-0.5 block text-small text-muted-foreground">{item.description}</span>}
                  </span>
                  <svg class="size-5 shrink-0 text-primary" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="m7.5 4 6 6-6 6" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</PrototypeLayout>
