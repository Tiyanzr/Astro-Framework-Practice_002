---
// /prototype/colors: palet warna.
// Semua nilai berasal dari token di src/styles/global.css (lihat DESIGN.md).
import PrototypeLayout from "@/prototype/PrototypeLayout.astro";

// Nama token hanya muncul sebagai tooltip saat kursor diarahkan.
const baseColors = ["white", "midnight"];
const mainColors = ["blue", "green", "mantis", "lime"];
// Turunan (color-mix dari palet) untuk latar selang-seling, garis, teks sekunder, hover.
const derived = ["background-alt", "border", "muted-foreground", "primary-hover"];
---

<PrototypeLayout title="Warna">
  <!-- Palet -->
  <section class="py-20">
    <div class="container-page space-y-3">
      <div class="grid grid-cols-2 gap-3">
        {baseColors.map((token) => (
          <div class="h-40 rounded-lg border border-border" style={`background:var(--${token})`} title={token}></div>
        ))}
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {mainColors.map((token) => (
          <div class="aspect-square rounded-lg" style={`background:var(--${token})`} title={token}></div>
        ))}
      </div>
      <div class="grid grid-cols-4 gap-3">
        {derived.map((token) => (
          <div class="h-20 rounded-lg border border-border" style={`background:var(--${token})`} title={token}></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section gelap (theme-dark): turunan yang sama, versi gelap -->
  <section class="theme-dark py-20">
    <div class="container-page grid grid-cols-4 gap-3">
      {derived.map((token) => (
        <div class="h-20 rounded-lg border border-border" style={`background:var(--${token})`} title={`${token} (dark)`}></div>
      ))}
    </div>
  </section>
</PrototypeLayout>
