---
// Kerangka semua halaman: <head>, navbar, isi halaman di <slot />, lalu footer.
// `bare`: tanpa navbar dan footer (dipakai halaman /prototype lewat src/prototype/PrototypeLayout.astro).
import "@/styles/global.css";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/footer/Footer.astro";
import { getSite } from "@/lib/content";

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
}

const site = await getSite();
const { title, description = site.description, bare = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!-- Seluruh situs memakai light mode. Untuk section gelap, pakai class `theme-dark` pada section-nya. -->
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <!-- flex + min-h-screen: footer tetap di dasar layar walaupun isi halaman pendek -->
  <body class="flex min-h-screen flex-col">
    {!bare && <Navbar />}
    <!-- pt-16: ruang untuk navbar yang fixed -->
    <main class:list={["flex-1", !bare && "pt-16"]}>
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
