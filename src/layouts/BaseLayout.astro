---
// Kerangka semua halaman: <head> (judul, deskripsi, canonical, Open Graph), navbar, isi halaman di <slot />, lalu footer.
// `bare`: tanpa navbar dan footer (dipakai halaman /prototype lewat src/prototype/PrototypeLayout.astro).
// Kit desain: `kit` (dari YAML halaman) atau site.yaml › kit, dipasang sebagai data-kit di body supaya warna/font/jarak
// kit itu (kits/<kit>/theme.css) berlaku. Semua theme.css kit dimuat; masing-masing hanya aktif di dalam [data-kit="<kit>"].
// Halaman bare (prototype) tidak diberi kit: setiap pratinjau membungkus dirinya dengan tema kit-nya sendiri.
import "@/styles/global.css";
import Navbar from "@/components/layout/navbar/Navbar.astro";
import Footer from "@/components/layout/footer/Footer.astro";
import { getSite } from "@/lib/content";

// Tema semua kit (CSS biasa, berlaku hanya di dalam [data-kit="<kit>"]).
import.meta.glob("/kits/*/theme.css", { eager: true });

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  /** Kit halaman (YAML halaman › kit). Kosong = site.yaml › kit. */
  kit?: string;
}

const site = await getSite();
const { title, description = site.description, bare = false, kit = site.kit } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : (site.homeTitle ?? site.name);
// URL kanonik: domain dari astro.config.mjs › site, path halaman ini (selalu diakhiri "/", sama seperti hasil build)
const canonical = Astro.site ? new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href : undefined;
---

<!-- Seluruh situs memakai light mode. Untuk section gelap, pakai class `theme-dark` pada section-nya. -->
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={site.lang === "id" ? "id_ID" : site.lang} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <!-- flex + min-h-screen: footer tetap di dasar layar walaupun isi halaman pendek -->
  <body class="flex min-h-screen flex-col" data-kit={bare ? undefined : kit}>
    {!bare && <Navbar pageKit={kit} />}
    <!-- Ruang untuk navbar fixed (kalau ada) diatur oleh variasi navbar itu sendiri. -->
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer pageKit={kit} />}
  </body>
</html>
