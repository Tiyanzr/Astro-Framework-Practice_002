---
// Kerangka semua halaman: <head> (judul, deskripsi, canonical, Open Graph), navbar, isi halaman di <slot />, lalu footer.
// `bare`: tanpa navbar dan footer (dipakai halaman /prototype lewat src/prototype/PrototypeLayout.astro).
// Palet situs dari site.yaml › theme ("parametris" = class .theme-parametris di body). Halaman bare tidak diberi palet,
// supaya prototype bisa memilih palet sendiri.
import "@/styles/global.css";
import Navbar from "@/components/layout/navbar/Navbar.astro";
import Footer from "@/components/layout/footer/Footer.astro";
import { getSite } from "@/lib/content";

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
}

const site = await getSite();
const { title, description = site.description, bare = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : (site.homeTitle ?? site.name);
// URL kanonik: domain dari astro.config.mjs › site, path halaman ini (selalu diakhiri "/", sama seperti hasil build)
const canonical = Astro.site ? new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href : undefined;
const themeClass = !bare && site.theme === "parametris" ? "theme-parametris" : undefined;
---

<!-- Seluruh situs memakai light mode. Untuk section gelap, pakai class `theme-dark` pada section-nya. -->
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={site.lang === "id" ? "id_ID" : site.lang} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <!-- flex + min-h-screen: footer tetap di dasar layar walaupun isi halaman pendek -->
  <body class:list={["flex min-h-screen flex-col", themeClass]}>
    {!bare && <Navbar />}
    <!-- Ruang untuk navbar fixed (kalau ada) diatur oleh variasi navbar itu sendiri. -->
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
