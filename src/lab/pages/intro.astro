---
// /preview/intro: semua variasi intro berurutan dengan isi yang sama (src/content/pages/home.yaml), untuk dibandingkan.
// Setiap variasi ditampilkan di semua tone (lihat src/lib/section.ts) dengan width bawaan variasinya. Pulldown dimatikan di sini.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Intro from "@/components/sections/intro/Intro.astro";
import VariantLabel from "@/components/ui/VariantLabel.astro";
import { introDefaults, introVariants } from "@/components/sections/intro/variants";
import { getPage } from "@/lib/content";
import { sectionTones } from "@/lib/section";

const { intro } = await getPage("home");
if (!intro) throw new Error("src/content/pages/home.yaml belum punya bagian `intro`.");
// Pengaturan pembungkus dari home.yaml tidak dipakai di sini, supaya setiap variasi tampil dengan bawaannya.
const { variant: _variant, tone: _tone, width: _width, pulldown: _pulldown, ...content } = intro;
---

<BaseLayout title="Preview · Intro">
  {
    Object.keys(introVariants).map((name) =>
      sectionTones.map((tone) => (
        <div>
          <VariantLabel name={`${name} · tone ${tone} · width ${introDefaults[name]?.width ?? "full"}`} />
          <Intro {...content} variant={name} tone={tone} pulldown={false} />
        </div>
      )),
    )
  }
</BaseLayout>
