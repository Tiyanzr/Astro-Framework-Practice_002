---
// /preview/hero: semua variasi hero berurutan dengan isi yang sama (src/content/pages/home.yaml), untuk dibandingkan.
// File variasi baru di src/components/sections/hero/ otomatis ikut tampil.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/hero/Hero.astro";
import VariantLabel from "@/components/ui/VariantLabel.astro";
import { heroVariants } from "@/components/sections/hero/variants";
import { getPage } from "@/lib/content";

const { hero } = await getPage("home");
---

<BaseLayout title="Preview · Hero">
  {
    Object.keys(heroVariants).map((name) => (
      <div>
        <VariantLabel name={name} />
        <Hero {...hero} variant={name} />
      </div>
    ))
  }
</BaseLayout>
