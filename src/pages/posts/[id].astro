---
// Satu halaman per file di src/content/posts/. URL: /posts/<nama-file>/
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-20 md:px-8">
    <p class="font-mono text-eyebrow text-primary uppercase">{post.data.pubDate.toLocaleDateString("id-ID", { dateStyle: "long" })}</p>
    <h1 class="mt-3 text-h1">{post.data.title}</h1>
    <p class="mt-4 text-lead text-muted-foreground">{post.data.description}</p>
    <div class="prose mt-10 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
