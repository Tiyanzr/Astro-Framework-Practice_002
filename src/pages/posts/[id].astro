---
// Satu halaman per folder di src/content/posts/. URL: /posts/<nama-folder>/ (postingan draft hanya tampil saat dev).
// Tampilan diatur variasi di kits/<kit>/post/ (site.yaml › post.variant, atau `variant` di frontmatter), kit = site.yaml › kit.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Post from "@/components/sections/post/Post.astro";
import { getPosts, getSite } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPosts({ withTestPosts: true });
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { kit } = await getSite();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Post post={post} pageKit={kit} />
</BaseLayout>
