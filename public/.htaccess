   ErrorDocument 404 /404.html

   # Paksa HTTPS dan satu versi domain (dengan www, sama seperti parametris.com)
   RewriteEngine On
   RewriteCond %{HTTPS} off [OR]
   RewriteCond %{HTTP_HOST} ^parametris\.com$ [NC]
   RewriteRule ^ https://www.parametris.com%{REQUEST_URI} [L,R=301]

   <IfModule mod_headers.c>
     <FilesMatch "^_astro/">
       Header set Cache-Control "public, max-age=31536000, immutable"
     </FilesMatch>
   </IfModule>