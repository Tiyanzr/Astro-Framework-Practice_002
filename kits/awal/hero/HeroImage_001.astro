---
// HeroImage_001: foto penuh selebar layar, gradasi gelap dari bawah, teks putih di kiri bawah.
import Button from "@/components/ui/Button.astro";
import HeroBackground from "@/components/sections/hero/HeroBackground.astro";
import type { HeroProps } from "@/components/sections/hero/types";

type Props = HeroProps;

const { eyebrow, title, description, actions = [], image, size = "xl" } = Astro.props;
---

<!-- theme-dark: teks, tombol, dan garis memakai token versi gelap di atas foto -->
<section
  class:list={[
    "theme-dark relative isolate flex items-end overflow-hidden",
    size === "xl" ? "min-h-[520px] md:min-h-[640px]" : "min-h-[400px] md:min-h-[480px]",
  ]}
>
  <HeroBackground image={image} />
  <!-- Gradasi agar teks tetap terbaca di foto apa pun -->
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/40 to-black/0" aria-hidden="true"></div>

  <!-- md:pb-36: ruang untuk section berikutnya yang memakai pulldown (ui/Section menarik ke atas 96px) -->
  <div class="container-page pt-32 pb-14 md:pb-36">
    <div class="max-w-3xl">
      {eyebrow && <p class="text-eyebrow font-semibold text-white/75 uppercase">{eyebrow}</p>}
      <h1 class:list={["text-balance text-white", size === "xl" ? "text-display-xl" : "text-display", eyebrow && "mt-4"]}>{title}</h1>
      {description && <p class="mt-6 max-w-2xl text-lead text-white/80">{description}</p>}
      {
        actions.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-3">
            {/* Tombol pertama = utama, sisanya sekunder. Jumlahnya mengikuti `actions` di YAML halaman. */}
            {actions.map((action, i) => (
              <Button href={action.href} variant={i === 0 ? "primary" : "secondary"} size="lg">
                {action.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
