---
// PostsBasic_001: versi bare minimum (tanpa desain). Daftar artikel: judul (link) + tanggal terbit, satu baris per artikel.
import { formatDate } from "@/components/sections/post/blocks/format";
import BasicHeading from "../parts/BasicHeading.astro";
import type { PostsProps } from "@/components/sections/posts/types";

type Props = PostsProps;

const { posts, more, ...heading } = Astro.props;
---

<BasicHeading {...heading} />
<ul>
  {
    posts.map((post) => (
      <li>
        <a href={post.href}>{post.title}</a>
        {post.pubDate && <> — <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time></>}
      </li>
    ))
  }
</ul>
{more && <p><a href={more.href}>{more.label}</a></p>}
