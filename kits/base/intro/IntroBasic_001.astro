---
// IntroBasic_001: versi bare minimum (tanpa desain). Hanya memastikan semua isi intro dari YAML tampil dan berfungsi.
import { Image } from "astro:assets";
import type { IntroContent } from "@/components/sections/intro/types";

type Props = IntroContent;

const { eyebrow, title, description, highlight, media } = Astro.props;
const paragraphs = description?.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) ?? [];
---

<div>
  {eyebrow && <p>{eyebrow}</p>}
  <h2>{title}</h2>
  {paragraphs.map((p) => <p>{p}</p>)}
  {highlight && <p><strong>{highlight}</strong></p>}
  {media?.type === "youtube" && <p><a href={`https://www.youtube.com/watch?v=${media.id}`}>{media.title}</a></p>}
  {media?.type === "image" && <Image src={media.src} alt={media.alt} widths={[640, 1280]} sizes="100vw" />}
  {media?.type === "placeholder" && <p>[{media.label ?? "Media"}]</p>}
</div>
