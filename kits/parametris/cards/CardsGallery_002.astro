---
// CardsGallery_002 (referensi: parametris.com, .service-gallery "LAYANAN"): kartu foto 3 kolom tanpa garis.
// Setiap kartu: foto 1.85:1 (2:1 di HP, membesar halus saat hover), nomor aksen, judul besar, deskripsi, link teks `linkLabel`.
import { Image } from "astro:assets";
import TextLink from "@/components/ui/TextLink.astro";
import SplitHeading from "../parts/SplitHeading.astro";
import { numbered } from "@/components/sections/types";
import type { CardsProps } from "@/components/sections/cards/types";

type Props = CardsProps;

const { items, linkLabel, ...heading } = Astro.props;
---

<SplitHeading {...heading} />
<ul class="grid grid-cols-1 gap-10 md:grid-cols-3">
  {
    items.map((item, i) => {
      const Tag = item.href ? "a" : "div";
      return (
        <li>
          <Tag href={item.href} class="group block">
            <div class="mb-6 aspect-[2/1] overflow-hidden bg-muted md:aspect-[1.85]">
              {item.image && (
                <Image
                  src={item.image.src}
                  alt={item.image.alt}
                  widths={[480, 800]}
                  sizes="(min-width: 48rem) 30vw, 90vw"
                  class="size-full object-cover transition-transform duration-[350ms] ease-out group-hover:scale-[1.035]"
                />
              )}
            </div>
            <span class="text-caption tracking-[0.1em] text-primary">{numbered(i)}</span>
            <h3 class="mt-[15px] mb-3.5 text-ref-h3-lg">{item.title}</h3>
            {item.description && <p class="text-muted-foreground md:min-h-[65px]">{item.description}</p>}
            {linkLabel && <TextLink class="mt-4">{linkLabel}</TextLink>}
          </Tag>
        </li>
      );
    })
  }
</ul>
