---
// CardsGallery_001 (referensi: parametris.com, .sector-gallery "INTERNET OF THINGS"): kartu foto 2 kolom.
// Setiap kartu: foto 2:1 (membesar halus saat hover), nomor aksen, judul, deskripsi, link teks `linkLabel`, garis bawah.
// Biasanya di tone dark (seperti referensi). Tanpa gambar tampil kotak polos warna kartu.
import { Image } from "astro:assets";
import TextLink from "@/components/ui/TextLink.astro";
import SplitHeading from "../parts/SplitHeading.astro";
import { numbered } from "@/components/sections/types";
import type { CardsProps } from "@/components/sections/cards/types";

type Props = CardsProps;

const { items, linkLabel, ...heading } = Astro.props;
---

<SplitHeading {...heading} />
<ul class:list={["grid grid-cols-1 gap-[30px] md:grid-cols-2 md:gap-x-8 md:gap-y-[42px]", !heading.title && !heading.accent && "mt-[45px]"]}>
  {
    items.map((item, i) => {
      const Tag = item.href ? "a" : "div";
      return (
        <li>
          <Tag href={item.href} class="group block border-b border-border pb-[25px]">
            <div class="mb-[23px] aspect-[2/1] overflow-hidden bg-card">
              {item.image && (
                <Image
                  src={item.image.src}
                  alt={item.image.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 48rem) 45vw, 90vw"
                  class="size-full object-cover transition-transform duration-[350ms] ease-out group-hover:scale-[1.035]"
                />
              )}
            </div>
            <div class="grid grid-cols-[32px_1fr] gap-2.5">
              <span class="pt-1 text-caption tracking-[0.1em] text-primary">{numbered(i)}</span>
              <div>
                <h3 class="m-0 text-[27px] leading-tight font-normal tracking-[-0.025em] transition-colors duration-300 group-hover:text-highlight md:text-[29px]">
                  {item.title}
                </h3>
                {item.description && <p class="mt-2 mb-2 text-muted-foreground">{item.description}</p>}
              </div>
              {linkLabel && <TextLink class="col-start-2 mt-2.5 justify-self-start">{linkLabel}</TextLink>}
            </div>
          </Tag>
        </li>
      );
    })
  }
</ul>
